# DJANGO
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MYSQL
DB_NAME=portifolio_tracker
DB_USER=root
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=3306

# REDIS / CELERY
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# FIREBASE (push notifications)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ANALISE DE SENTIMENTO
SENTIMENT_QUEUE=
SENTIMENT_FALLBACK_LANGUAGE=

# LLM EXTERNA (opcional). Deixe LLM_ENABLED=false para usar so o motor local.
# Nunca coloque o valor real da chave neste arquivo.
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
LLM_LANGUAGES=

