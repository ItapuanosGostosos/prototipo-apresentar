{
  "info": {
    "name": "Portifolio Tracker API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/register/",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gui@example.com\",\n  \"username\": \"gui\",\n  \"password\": \"strongpass123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('access_token', json.access);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/login/",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gui@example.com\",\n  \"password\": \"strongpass123\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/refresh/",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"SEU_REFRESH_TOKEN_AQUI\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/me/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Portfolios",
      "item": [
        {
          "name": "List Portfolios",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/portfolios/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ]
          }
        },
        {
          "name": "Create Portfolio",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/portfolios/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Minha Carteira\"\n}"
            }
          }
        },
        {
          "name": "Get Portfolio",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/portfolios/1/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ]
          }
        },
        {
          "name": "Update Portfolio",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/api/portfolios/1/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carteira Editada\"\n}"
            }
          }
        },
        {
          "name": "Delete Portfolio",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/portfolios/1/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Assets",
      "item": [
        {
          "name": "List Assets",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/portfolios/1/assets/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ]
          }
        },
        {
          "name": "Add Asset - Ação",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/portfolios/1/assets/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticker\": \"PETR4\",\n  \"name\": \"Petrobras\",\n  \"asset_type\": \"stock\"\n}"
            }
          }
        },
        {
          "name": "Add Asset - FII",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/portfolios/1/assets/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticker\": \"HGLG11\",\n  \"name\": \"CSHG Logística\",\n  \"asset_type\": \"fii\"\n}"
            }
          }
        },
        {
          "name": "Add Asset - Crypto",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/portfolios/1/assets/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticker\": \"BTC-USD\",\n  \"name\": \"Bitcoin\",\n  \"asset_type\": \"crypto\"\n}"
            }
          }
        },
        {
          "name": "Delete Asset",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/portfolios/1/assets/1/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "News",
      "item": [
        {
          "name": "Global News (todas as carteiras)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/news/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ]
          }
        },
        {
          "name": "Portfolio News",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/news/portfolio/1/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Register Device Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/notifications/device-token/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"fcm-device-token-exemplo\",\n  \"platform\": \"android\"\n}"
            }
          }
        },
        {
          "name": "Deactivate Device Token",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/notifications/device-token/",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"fcm-device-token-exemplo\"\n}"
            }
          }
        }
      ]
    }
  ]
}
