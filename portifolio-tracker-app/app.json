{
  "expo": {
    "name": "Portfólio Tracker",
    "slug": "portifolio-tracker-mobile",
    "scheme": "portifoliotracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0714",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0714"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.portifoliotracker.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060120"
      },
      "package": "com.portifoliotracker.app",
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "962786b5-ad95-4b83-9f91-aa687471a248"
      }
    },
    "owner": "matheuscosta616"
  }
}
